# ============================================
# WordPress Core
# wp-admin/ wp-includes/ and root php files are tracked
# ============================================

# ============================================
# wp-content partial tracking
# ============================================
/wp-content/uploads/*
!/wp-content/uploads/.gitkeep

/wp-content/upgrade/
/wp-content/cache/
/wp-content/backups/
/wp-content/blogs.dir/

# Third-party plugins (track via docs/plugins.md)
/wp-content/plugins/*
!/wp-content/plugins/.gitkeep
# Custom plugins (whitelist for version control)
!/wp-content/plugins/study-abroad-core/
!/wp-content/plugins/study-abroad-core/**

# Default themes (keep only custom themes)
/wp-content/themes/twenty*/

# ============================================
# Sensitive files
# ============================================
wp-config.php
.htaccess
*.sql
*.sql.gz
*.log
.env
.env.*

# ============================================
# 不应出现在网站根目录的文件（安全加固）
# ------------------------------------------------------------
# 这些文件可被公网直接下载：
#   readme.html / license.txt  会暴露 WordPress 版本号，便于针对性攻击
#   wp-cli.phar                可执行 PHP 归档，7MB，不应放在 web 根目录
#   主题/插件压缩包             会泄露完整源码
# WordPress 核心升级会重新生成 readme.html 与 license.txt，
# 在此忽略可避免它们再次进入版本控制。
# wp-cli 请安装到 /usr/local/bin/wp 而非站点目录。
# ============================================
readme.html
license.txt
wp-cli.phar
/wp-content/themes/*.zip
/wp-content/plugins/*.zip

# ============================================
# OS and IDE
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Playwright MCP browser snapshots (test artifacts)
.playwright-mcp/

# ============================================
# BT Panel generated files
# ============================================
.user.ini
.well-known/

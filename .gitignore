# ============================================
# WordPress Core
# wp-admin/ wp-includes/ and root php files are tracked
# ============================================

# ============================================
# wp-content partial tracking
# ============================================
/wp-content/uploads/*
!/wp-content/uploads/.gitkeep

/wp-content/upgrade/
/wp-content/cache/
/wp-content/backups/
/wp-content/blogs.dir/

# Third-party plugins (track via docs/plugins.md)
/wp-content/plugins/*
!/wp-content/plugins/.gitkeep
# Custom plugins (whitelist for version control)
!/wp-content/plugins/study-abroad-core/
!/wp-content/plugins/study-abroad-core/**

# Default themes (keep only custom themes)
/wp-content/themes/twenty*/

# ============================================
# Sensitive files
# ============================================
wp-config.php
.htaccess
*.sql
*.sql.gz
*.log
.env
.env.*

# ============================================
# 不应出现在网站根目录的文件（安全加固）
# ------------------------------------------------------------
# 这些文件可被公网直接下载：
#   readme.html / license.txt  会暴露 WordPress 版本号，便于针对性攻击
#   wp-cli.phar                可执行 PHP 归档，7MB，不应放在 web 根目录
#   主题/插件压缩包             会泄露完整源码
# WordPress 核心升级会重新生成 readme.html 与 license.txt，
# 在此忽略可避免它们再次进入版本控制。
# wp-cli 请安装到 /usr/local/bin/wp 而非站点目录。
# ============================================
readme.html
license.txt
wp-cli.phar
/wp-content/themes/*.zip
/wp-content/plugins/*.zip

# ============================================
# OS and IDE
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Playwright MCP browser snapshots (test artifacts)
.playwright-mcp/

# ============================================
# BT Panel generated files
# ============================================
.user.ini
.well-known/

# ============================================
# WordPress 核心语言包（由 WordPress 自动下载管理）
# ------------------------------------------------------------
# wp-content/languages/ 下的 admin-*.mo / *.l10n.php 等文件由 WordPress
# 按当前使用的 locale 自动下载并随核心升级更新。
# 纳入版本控制会有两个问题：
#   1. 站点启用新语种时自动下载的文件会持续出现在 git status 中，
#      淹没真正需要关注的改动（本项目切到三语后就出现了 ja 语言包噪声）
#   2. 体积大（数 MB）且与代码无关
# 主题自己的语言包（wp-content/themes/*/languages/）仍然纳入版本控制 ——
# 那是本项目的翻译成果，必须随代码一起发布。
#
# 注意：.gitignore 不影响已被跟踪的文件，因此此前已入库的 zh_CN 核心语言包
# 仍然正常跟踪与更新（不会被删除，服务器后台语言不受影响）；
# 本规则只用于拦截此后新下载的语言包，避免它们持续出现在 git status 中。
# ============================================
/wp-content/languages/*

# 翻译编译状态标记（i18n-build.sh 用于判断 .po 是否变化以跳过重编译）
# 属于本机构建状态，不应入库。
/wp-content/themes/*/languages/.*.build

# ============================================
# 院校信息采集产物
# ------------------------------------------------------------
# scripts/fetch-school-data.php 抓下来的页面文本与 SUMMARY.txt。
# 属于每台机器各自的中间产物，且体积随抓取页数增长。
#
# 曾经误入库一次：在开发环境跑测试时生成的 SUMMARY.txt 被 git add -A
# 一并提交，导致生产服务器 merge 时报
#   "untracked working tree files would be overwritten by merge"
# —— 更糟的是，若合并成功会用开发环境的失败记录覆盖掉服务器上
# 真实的采集结果。这类文件必须留在各自机器上。
# ============================================
/scripts/school-data/
